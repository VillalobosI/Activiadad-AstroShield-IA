      "source": [
        "# Archivo: algoritmo_evolutivo.py\n",
        "# Representación de los 8 satélites y estructura del algoritmo evolutivo\n",
        "import random\n",
        "import copy\n",
        "import restricciones_fitness as rf\n",
        "NUM_SATELITES = 8\n",
        "def crear_satelite_aleatorio():\n",
        "    \"\"\"Crea un satélite con latitud [-90, 90] y longitud [-180, 180] aleatorias.\"\"\"\n",
        "    latitud = random.uniform(-90.0, 90.0)\n",
        "    longitud = random.uniform(-180.0, 180.0)\n",
        "    return [latitud, longitud]\n",
        "def crear_configuracion_aleatoria():\n",
        "    \"\"\"Genera una constelación de 8 satélites en posiciones aleatorias.\"\"\"\n",
        "    configuracion = []\n",
        "    for i in range(NUM_SATELITES):\n",
        "        satelite = crear_satelite_aleatorio()\n",
        "        configuracion.append(satelite)\n",
        "    return configuracion\n",
        "def crear_poblacion_inicial(tamano_poblacion):\n",
        "    \"\"\"Crea una lista de configuraciones aleatorias.\"\"\"\n",
        "    poblacion = []\n",
        "    for i in range(tamano_poblacion):\n",
        "        individuo = crear_configuracion_aleatoria()\n",
        "        poblacion.append(individuo)\n",
        "    return poblacion\n",
        "def seleccion_por_torneo(poblacion, puntajes_fitness, tamano_torneo=3):\n",
        "    \"\"\"Selecciona al mejor individuo de una muestra aleatoria de la población.\"\"\"\n",
        "    indices_participantes = []\n",
        "    total_individuos = len(poblacion)\n",
        "    for i in range(tamano_torneo):\n",
        "        indice_azar = random.randint(0, total_individuos - 1)\n",
        "        indices_participantes.append(indice_azar)\n",
        "    mejor_indice = indices_participantes[0]\n",
        "    mejor_puntaje = puntajes_fitness[mejor_indice]\n",
        "    for indice in indices_participantes:\n",
        "        if puntajes_fitness[indice] > mejor_puntaje:\n",
        "            mejor_puntaje = puntajes_fitness[indice]\n",
        "            mejor_indice = indice\n",
        "    return copy.deepcopy(poblacion[mejor_indice])\n",
        "def cruzar_configuraciones(padre1, padre2):\n",
        "    \"\"\"Cruza dos configuraciones de 8 satélites usando un punto de corte.\"\"\"\n",
        "    punto_corte = random.randint(1, NUM_SATELITES - 1)\n",
        "    hijo = []\n",
        "    for i in range(NUM_SATELITES):\n",
        "        if i < punto_corte:\n",
        "            hijo.append(copy.deepcopy(padre1[i]))\n",
        "        else:\n",
        "            hijo.append(copy.deepcopy(padre2[i]))\n",
        "    return hijo\n",
        "def mutar_configuracion(configuracion, probabilidad_mutacion=0.25):\n",
        "    \"\"\"Modifica ligeramente las coordenadas de los satélites según una probabilidad.\"\"\"\n",
        "    nueva_config = copy.deepcopy(configuracion)\n",
        "    for i in range(NUM_SATELITES):\n",
        "        azar = random.random()\n",
        "        if azar < probabilidad_mutacion:\n",
        "            # 80% de las veces hacemos un ajuste pequeño (búsqueda local)\n",
        "            # 20% de las veces movemos el satélite a una posición totalmente nueva\n",
        "            if random.random() < 0.8:\n",
        "                cambio_lat = random.gauss(0, 8.0)\n",
        "                cambio_lon = random.gauss(0, 8.0)\n",
        "                nueva_lat = nueva_config[i][0] + cambio_lat\n",
        "                nueva_lon = nueva_config[i][1] + cambio_lon\n",
        "                # Mantener latitud entre -90 y 90\n",
        "                if nueva_lat > 90.0:\n",
        "                    nueva_lat = 90.0\n",
        "                if nueva_lat < -90.0:\n",
        "                    nueva_lat = -90.0\n",
        "                # Mantener longitud entre -180 y 180\n",
        "                if nueva_lon > 180.0:\n",
        "                    nueva_lon = nueva_lon - 360.0\n",
        "                if nueva_lon < -180.0:\n",
        "                    nueva_lon = nueva_lon + 360.0\n",
        "                nueva_config[i] = [nueva_lat, nueva_lon]\n",
        "            else:\n",
        "                nueva_config[i] = crear_satelite_aleatorio()\n",
        "    return nueva_config\n",
        "def ejecutar_algoritmo_evolutivo(\n",
        "    tamano_poblacion=60,\n",
        "    generaciones=100,\n",
        "    probabilidad_mutacion=0.25,\n",
        "    regiones=None,\n",
        "    zonas_desechos=None,\n",
        "    objetos_ocupados=None,\n",
        "    mostrar_progreso=True\n",
        "):\n",
        "    \"\"\"\n",
        "    Ejecuta el ciclo principal del algoritmo evolutivo y devuelve:\n",
        "    - mejor_configuracion_inicial\n",
        "    - mejor_configuracion_final\n",
        "    - historial_mejor_fitness\n",
        "    - historial_promedio_fitness\n",
        "    \"\"\"\n",
        "    if regiones is None:\n",
        "        regiones = rf.obtener_regiones_iniciales()\n",
        "    if zonas_desechos is None:\n",
        "        zonas_desechos = rf.obtener_zonas_desechos_iniciales()\n",
        "    if objetos_ocupados is None:\n",
        "        objetos_ocupados = rf.obtener_objetos_ocupados_iniciales()\n",
        "    poblacion = crear_poblacion_inicial(tamano_poblacion)\n",
        "    historial_mejor_fitness = []\n",
        "    historial_promedio_fitness = []\n",
        "    mejor_configuracion_inicial = None\n",
        "    mejor_configuracion_global = None\n",
        "    mejor_fitness_global = -999999.0\n",
        "    for gen in range(generaciones):\n",
        "        puntajes_fitness = []\n",
        "        suma_fitness = 0.0\n",
        "        # 1. Evaluar toda la población actual\n",
        "        for individuo in poblacion:\n",
        "            resultado = rf.evaluar_configuracion(\n",
        "                individuo, regiones, zonas_desechos, objetos_ocupados\n",
        "            )\n",
        "            fitness_ind = resultado[\"fitness\"]\n",
        "            puntajes_fitness.append(fitness_ind)\n",
        "            suma_fitness += fitness_ind\n",
        "            if fitness_ind > mejor_fitness_global:\n",
        "                mejor_fitness_global = fitness_ind\n",
        "                mejor_configuracion_global = copy.deepcopy(individuo)\n",
        "        # Guardar la mejor configuración de la generación 0 para comparar después\n",
        "        if gen == 0:\n",
        "            indice_mejor_gen0 = 0\n",
        "            for i in range(len(puntajes_fitness)):\n",
        "                if puntajes_fitness[i] > puntajes_fitness[indice_mejor_gen0]:\n",
        "                    indice_mejor_gen0 = i\n",
        "            mejor_configuracion_inicial = copy.deepcopy(poblacion[indice_mejor_gen0])\n",
        "        promedio_actual = suma_fitness / tamano_poblacion\n",
        "        historial_mejor_fitness.append(mejor_fitness_global)\n",
        "        historial_promedio_fitness.append(promedio_actual)\n",
        "        if mostrar_progreso and (gen % 20 == 0 or gen == generaciones - 1):\n",
        "            info_mejor = rf.evaluar_configuracion(\n",
        "                mejor_configuracion_global, regiones, zonas_desechos, objetos_ocupados\n",
        "            )\n",
        "            print(\n",
        "                f\"Generación {gen:3d} | Mejor Fitness: {mejor_fitness_global:7.2f} | \"\n",
        "                f\"Promedio: {promedio_actual:7.2f} | \"\n",
        "                f\"Regiones cubiertas: {len(info_mejor['regiones_cubiertas'])}/{len(regiones)} | \"\n",
        "                f\"Válida: {info_mejor['es_valida']}\"\n",
        "            )\n",
        "        # 2. Ordenar índices de mejor a peor para aplicar Elitismo (conservar los 2 mejores)\n",
        "        indices_ordenados = list(range(tamano_poblacion))\n",
        "        for i in range(tamano_poblacion):\n",
        "            for j in range(i + 1, tamano_poblacion):\n",
        "                if puntajes_fitness[indices_ordenados[j]] > puntajes_fitness[indices_ordenados[i]]:\n",
        "                    temp = indices_ordenados[i]\n",
        "                    indices_ordenados[i] = indices_ordenados[j]\n",
        "                    indices_ordenados[j] = temp\n",
        "        nueva_poblacion = []\n",
        "        nueva_poblacion.append(copy.deepcopy(poblacion[indices_ordenados[0]]))\n",
        "        nueva_poblacion.append(copy.deepcopy(poblacion[indices_ordenados[1]]))\n",
        "        # 3. Generar el resto de la nueva población mediante torneo, cruza y mutación\n",
        "        while len(nueva_poblacion) < tamano_poblacion:\n",
        "            padre1 = seleccion_por_torneo(poblacion, puntajes_fitness)\n",
        "            padre2 = seleccion_por_torneo(poblacion, puntajes_fitness)\n",
        "            hijo = cruzar_configuraciones(padre1, padre2)\n",
        "            hijo_mutado = mutar_configuracion(hijo, probabilidad_mutacion)\n",
        "            nueva_poblacion.append(hijo_mutado)\n",
        "        poblacion = nueva_poblacion\n",
        "    return {\n",
        "        \"configuracion_inicial\": mejor_configuracion_inicial,\n",
        "        \"configuracion_final\": mejor_configuracion_global,\n",
        "        \"historial_mejor\": historial_mejor_fitness,\n",
        "        \"historial_promedio\": historial_promedio_fitness\n",
        "    }\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"=== Ejecutando Algoritmo Evolutivo AstroShield ===\")\n",
        "    resultados = ejecutar_algoritmo_evolutivo(\n",
        "        tamano_poblacion=60,\n",
        "        generaciones=100,\n",
        "        probabilidad_mutacion=0.25,\n",
        "        mostrar_progreso=True\n",
        "    )\n",
        "    evaluacion_final = rf.evaluar_configuracion(resultados[\"configuracion_final\"])\n",
        "    print(\"\\n=== Resumen de la Configuración Final ===\")\n",
        "    print(\"Fitness Final:\", round(evaluacion_final[\"fitness\"], 2))\n",
        "    print(\"¿Cumple todas las restricciones?:\", evaluacion_final[\"es_valida\"])\n",
        "    print(\"Regiones cubiertas:\", evaluacion_final[\"regiones_cubiertas\"])\n",
        "    print(\"Regiones NO cubiertas:\", evaluacion_final[\"regiones_no_cubiertas\"])\n",
        "    print(\"\\nCoordenadas de los 8 satélites (Latitud, Longitud):\")\n",
        "    for idx, sat in enumerate(resultados[\"configuracion_final\"]):\n",
        "        print(f\"  Satélite {idx + 1}: Lat = {sat[0]:6.2f}°, Lon = {sat[1]:7.2f}°\")\n",
        "# Archivo: restricciones_fitness.py\n",
        "# Función de fitness, cálculo de cobertura de las 6 regiones y filtro de restricciones\n",
        "import math\n",
        "RADIO_TIERRA_KM = 6371.0\n",
        "RADIO_OBSERVACION_REGION_KM = 300.0\n",
        "ALCANCE_MAXIMO_SATELITE_KM = 1200.0  # Radio dentro del cual el satélite logra cubrir los 300 km de la región\n",
        "def obtener_regiones_iniciales():\n",
        "    \"\"\"Devuelve las 6 regiones de interés con sus coordenadas y prioridades.\"\"\"\n",
        "    return [\n",
        "        {\"nombre\": \"Península de Yucatán, México\", \"lat\": 20.5, \"lon\": -89.0, \"prioridad\": \"Alta\", \"puntos\": 300},\n",
        "        {\"nombre\": \"Amazonía brasileña\", \"lat\": -3.5, \"lon\": -62.0, \"prioridad\": \"Alta\", \"puntos\": 300},\n",
        "        {\"nombre\": \"California, Estados Unidos\", \"lat\": 36.8, \"lon\": -119.4, \"prioridad\": \"Media\", \"puntos\": 200},\n",
        "        {\"nombre\": \"Región del Sahel, África\", \"lat\": 15.0, \"lon\": 0.0, \"prioridad\": \"Media\", \"puntos\": 200},\n",
        "        {\"nombre\": \"Japón\", \"lat\": 36.0, \"lon\": 138.0, \"prioridad\": \"Media\", \"puntos\": 200},\n",
        "        {\"nombre\": \"Interior de Australia\", \"lat\": -25.0, \"lon\": 133.0, \"prioridad\": \"Normal\", \"puntos\": 100}\n",
        "    ]\n",
        "def obtener_zonas_desechos_iniciales():\n",
        "    \"\"\"Devuelve las 3 zonas restringidas por desechos espaciales (radios en grados).\"\"\"\n",
        "    return [\n",
        "        {\"nombre\": \"Atlántico Norte\", \"lat\": 45.0, \"lon\": -35.0, \"radio_grados\": 12.0},\n",
        "        {\"nombre\": \"Pacífico Sur\", \"lat\": -30.0, \"lon\": -120.0, \"radio_grados\": 10.0},\n",
        "        {\"nombre\": \"Región polar norte\", \"lat\": 78.0, \"lon\": 30.0, \"radio_grados\": 8.0}\n",
        "    ]\n",
        "def obtener_objetos_ocupados_iniciales():\n",
        "    \"\"\"Devuelve los 2 objetos existentes con su radio de exclusión en grados.\"\"\"\n",
        "    return [\n",
        "        {\"nombre\": \"Objeto A\", \"lat\": 10.0, \"lon\": 45.0, \"radio_grados\": 5.0},\n",
        "        {\"nombre\": \"Objeto B\", \"lat\": -15.0, \"lon\": 110.0, \"radio_grados\": 5.0}\n",
        "    ]\n",
        "def calcular_distancia_angular_grados(lat1, lon1, lat2, lon2):\n",
        "    \"\"\"\n",
        "    Calcula la distancia angular en grados sobre una esfera entre dos coordenadas\n",
        "    usando la ley esférica de Haversine.\n",
        "    \"\"\"\n",
        "    rad_lat1 = math.radians(lat1)\n",
        "    rad_lon1 = math.radians(lon1)\n",
        "    rad_lat2 = math.radians(lat2)\n",
        "    rad_lon2 = math.radians(lon2)\n",
        "    delta_lat = rad_lat2 - rad_lat1\n",
        "    delta_lon = rad_lon2 - rad_lon1\n",
        "    a = (math.sin(delta_lat / 2.0) ** 2) + \\\n",
        "        math.cos(rad_lat1) * math.cos(rad_lat2) * (math.sin(delta_lon / 2.0) ** 2)\n",
        "    # Evitar errores de redondeo fuera del rango [0, 1]\n",
        "    if a > 1.0:\n",
        "        a = 1.0\n",
        "    if a < 0.0:\n",
        "        a = 0.0\n",
        "    angulo_central_rad = 2.0 * math.atan2(math.sqrt(a), math.sqrt(1.0 - a))\n",
        "    distancia_grados = math.degrees(angulo_central_rad)\n",
        "    return distancia_grados\n",
        "def calcular_distancia_km(lat1, lon1, lat2, lon2):\n",
        "    \"\"\"Calcula la distancia superficial en kilómetros entre dos puntos de la Tierra.\"\"\"\n",
        "    grados = calcular_distancia_angular_grados(lat1, lon1, lat2, lon2)\n",
        "    radianes = math.radians(grados)\n",
        "    return RADIO_TIERRA_KM * radianes\n",
        "def verificar_restricciones(configuracion, zonas_desechos, objetos_ocupados):\n",
        "    \"\"\"\n",
        "    Revisa si algún satélite invade las 3 zonas de desechos, los 2 objetos ocupados,\n",
        "    o si dos satélites chocan entre sí.\n",
        "    \"\"\"\n",
        "    violaciones = []\n",
        "    for i in range(len(configuracion)):\n",
        "        sat_lat = configuracion[i][0]\n",
        "        sat_lon = configuracion[i][1]\n",
        "        # 1. Revisar las 3 zonas de desechos espaciales\n",
        "        for zona in zonas_desechos:\n",
        "            dist_grados = calcular_distancia_angular_grados(\n",
        "                sat_lat, sat_lon, zona[\"lat\"], zona[\"lon\"]\n",
        "            )\n",
        "            if dist_grados <= zona[\"radio_grados\"]:\n",
        "                violaciones.append(\n",
        "                    f\"Satélite {i + 1} invade zona de desechos '{zona['nombre']}' \"\n",
        "                    f\"(distancia {dist_grados:.2f}° <= {zona['radio_grados']}°)\"\n",
        "                )\n",
        "        # 2. Revisar los 2 objetos existentes\n",
        "        for obj in objetos_ocupados:\n",
        "            dist_grados = calcular_distancia_angular_grados(\n",
        "                sat_lat, sat_lon, obj[\"lat\"], obj[\"lon\"]\n",
        "            )\n",
        "            if dist_grados <= obj[\"radio_grados\"]:\n",
        "                violaciones.append(\n",
        "                    f\"Satélite {i + 1} invade zona de exclusión de '{obj['nombre']}' \"\n",
        "                    f\"(distancia {dist_grados:.2f}° <= {obj['radio_grados']}°)\"\n",
        "                )\n",
        "        # 3. Revisar separación mínima entre satélites de la misma constelación (mínimo 2°)\n",
        "        for j in range(i + 1, len(configuracion)):\n",
        "            dist_entre_sat = calcular_distancia_angular_grados(\n",
        "                sat_lat, sat_lon, configuracion[j][0], configuracion[j][1]\n",
        "            )\n",
        "            if dist_entre_sat < 2.0:\n",
        "                violaciones.append(\n",
        "                    f\"Satélites {i + 1} y {j + 1} demasiado cerca ({dist_entre_sat:.2f}° < 2.0°)\"\n",
        "                )\n",
        "    return violaciones\n",
        "def evaluar_configuracion(configuracion, regiones=None, zonas_desechos=None, objetos_ocupados=None):\n",
        "    \"\"\"\n",
        "    Calcula el fitness total de una constelación de 8 satélites, considerando:\n",
        "    - Puntos por cubrir cada una de las 6 regiones según su prioridad.\n",
        "    - Bono por cercanía óptima dentro del radio de 300 km de cada región.\n",
        "    - Penalización fuerte por cada violación a zonas de desechos u objetos existentes.\n",
        "    \"\"\"\n",
        "    if regiones is None:\n",
        "        regiones = obtener_regiones_iniciales()\n",
        "    if zonas_desechos is None:\n",
        "        zonas_desechos = obtener_zonas_desechos_iniciales()\n",
        "    if objetos_ocupados is None:\n",
        "        objetos_ocupados = obtener_objetos_ocupados_iniciales()\n",
        "    puntaje_total = 0.0\n",
        "    regiones_cubiertas = []\n",
        "    regiones_no_cubiertas = []\n",
        "    distancias_minimas_regiones = {}\n",
        "    # 1. Evaluar cobertura de las 6 regiones\n",
        "    for region in regiones:\n",
        "        mejor_distancia_km = 999999.0\n",
        "        for satelite in configuracion:\n",
        "            dist_km = calcular_distancia_km(\n",
        "                satelite[0], satelite[1], region[\"lat\"], region[\"lon\"]\n",
        "            )\n",
        "            if dist_km < mejor_distancia_km:\n",
        "                mejor_distancia_km = dist_km\n",
        "        distancias_minimas_regiones[region[\"nombre\"]] = round(mejor_distancia_km, 2)\n",
        "        if mejor_distancia_km <= ALCANCE_MAXIMO_SATELITE_KM:\n",
        "            regiones_cubiertas.append(region[\"nombre\"])\n",
        "            # Sumar puntos base según prioridad (Alta=300, Media=200, Normal=100)\n",
        "            puntaje_total += region[\"puntos\"]\n",
        "            # Bono extra si el satélite se posiciona dentro de los 300 km centrales de observación\n",
        "            if mejor_distancia_km <= RADIO_OBSERVACION_REGION_KM:\n",
        "                bono_precision = 50.0 * (1.0 - (mejor_distancia_km / RADIO_OBSERVACION_REGION_KM))\n",
        "                puntaje_total += bono_precision\n",
        "            else:\n",
        "                # Pequeño bono proporcional por acercarse al radio de 300 km\n",
        "                proporcion = (ALCANCE_MAXIMO_SATELITE_KM - mejor_distancia_km) / (\n",
        "                    ALCANCE_MAXIMO_SATELITE_KM - RADIO_OBSERVACION_REGION_KM\n",
        "                )\n",
        "                puntaje_total += 20.0 * proporcion\n",
        "        else:\n",
        "            regiones_no_cubiertas.append(region[\"nombre\"])\n",
        "            # Pequeña guía gradual para que el algoritmo sepa si se está acercando a una región no cubierta\n",
        "            guia_cercania = max(0.0, 20.0 * (1.0 - (mejor_distancia_km / 10000.0)))\n",
        "            puntaje_total += guia_cercania\n",
        "    # 2. Bono por buena distribución entre satélites (evitar amontonamiento innecesario)\n",
        "    for i in range(len(configuracion)):\n",
        "        for j in range(i + 1, len(configuracion)):\n",
        "            dist_grados = calcular_distancia_angular_grados(\n",
        "                configuracion[i][0], configuracion[i][1],\n",
        "                configuracion[j][0], configuracion[j][1]\n",
        "            )\n",
        "            if dist_grados >= 10.0:\n",
        "                puntaje_total += 1.5\n",
        "    # 3. Aplicar filtro de restricciones (zonas de desechos y posiciones ocupadas)\n",
        "    violaciones = verificar_restricciones(configuracion, zonas_desechos, objetos_ocupados)\n",
        "    es_valida = len(violaciones) == 0\n",
        "    if not es_valida:\n",
        "        # Penalización estricta de -1000 puntos por cada violación detectada\n",
        "        puntaje_total -= 1000.0 * len(violaciones)\n",
        "    return {\n",
        "        \"fitness\": puntaje_total,\n",
        "        \"es_valida\": es_valida,\n",
        "        \"violaciones\": violaciones,\n",
        "        \"regiones_cubiertas\": regiones_cubiertas,\n",
        "        \"regiones_no_cubiertas\": regiones_no_cubiertas,\n",
        "        \"distancias_km\": distancias_minimas_regiones\n",
        "    }"
      ]
    }


RADIO_TIERRA_KM = 6371.0
RADIO_OBSERVACION_REGION_KM = 300.0
ALCANCE_MAXIMO_SATELITE_KM = 1200.0  # Radio dentro del cual el satélite logra cubrir los 300 km de la región


def obtener_regiones_iniciales():
    """Devuelve las 6 regiones de interés con sus coordenadas y prioridades."""
    return [
        {"nombre": "Península de Yucatán, México", "lat": 20.5, "lon": -89.0, "prioridad": "Alta", "puntos": 300},
        {"nombre": "Amazonía brasileña", "lat": -3.5, "lon": -62.0, "prioridad": "Alta", "puntos": 300},
        {"nombre": "California, Estados Unidos", "lat": 36.8, "lon": -119.4, "prioridad": "Media", "puntos": 200},
        {"nombre": "Región del Sahel, África", "lat": 15.0, "lon": 0.0, "prioridad": "Media", "puntos": 200},
        {"nombre": "Japón", "lat": 36.0, "lon": 138.0, "prioridad": "Media", "puntos": 200},
        {"nombre": "Interior de Australia", "lat": -25.0, "lon": 133.0, "prioridad": "Normal", "puntos": 100}
    ]


def obtener_zonas_desechos_iniciales():
    """Devuelve las 3 zonas restringidas por desechos espaciales (radios en grados)."""
    return [
        {"nombre": "Atlántico Norte", "lat": 45.0, "lon": -35.0, "radio_grados": 12.0},
        {"nombre": "Pacífico Sur", "lat": -30.0, "lon": -120.0, "radio_grados": 10.0},
        {"nombre": "Región polar norte", "lat": 78.0, "lon": 30.0, "radio_grados": 8.0}
    ]


def obtener_objetos_ocupados_iniciales():
    """Devuelve los 2 objetos existentes con su radio de exclusión en grados."""
    return [
        {"nombre": "Objeto A", "lat": 10.0, "lon": 45.0, "radio_grados": 5.0},
        {"nombre": "Objeto B", "lat": -15.0, "lon": 110.0, "radio_grados": 5.0}
    ]


def calcular_distancia_angular_grados(lat1, lon1, lat2, lon2):
    """
    Calcula la distancia angular en grados sobre una esfera entre dos coordenadas
    usando la fórmula esférica de Haversine.
    """
    rad_lat1 = math.radians(lat1)
    rad_lon1 = math.radians(lon1)
    rad_lat2 = math.radians(lat2)
    rad_lon2 = math.radians(lon2)

    delta_lat = rad_lat2 - rad_lat1
    delta_lon = rad_lon2 - rad_lon1

    a = (math.sin(delta_lat / 2.0) ** 2) + \
        math.cos(rad_lat1) * math.cos(rad_lat2) * (math.sin(delta_lon / 2.0) ** 2)

    if a > 1.0:
        a = 1.0
    if a < 0.0:
        a = 0.0

    angulo_central_rad = 2.0 * math.atan2(math.sqrt(a), math.sqrt(1.0 - a))
    distancia_grados = math.degrees(angulo_central_rad)
    return distancia_grados


def calcular_distancia_km(lat1, lon1, lat2, lon2):
    """Calcula la distancia superficial en kilómetros entre dos puntos de la Tierra."""
    grados = calcular_distancia_angular_grados(lat1, lon1, lat2, lon2)
    radianes = math.radians(grados)
    return RADIO_TIERRA_KM * radianes


def verificar_restricciones(configuracion, zonas_desechos, objetos_ocupados):
    """
    Revisa si algún satélite invade las 3 zonas de desechos, los 2 objetos ocupados,
    o si dos satélites chocan entre sí.
    """
    violaciones = []

    for i in range(len(configuracion)):
        sat_lat = configuracion[i][0]
        sat_lon = configuracion[i][1]

        # 1. Revisar las 3 zonas de desechos espaciales
        for zona in zonas_desechos:
            dist_grados = calcular_distancia_angular_grados(
                sat_lat, sat_lon, zona["lat"], zona["lon"]
            )
            if dist_grados <= zona["radio_grados"]:
                violaciones.append(
                    f"Satélite {i + 1} invade zona de desechos '{zona['nombre']}' "
                    f"(distancia {dist_grados:.2f}° <= {zona['radio_grados']}°)"
                )

        # 2. Revisar los 2 objetos existentes
        for obj in objetos_ocupados:
            dist_grados = calcular_distancia_angular_grados(
                sat_lat, sat_lon, obj["lat"], obj["lon"]
            )
            if dist_grados <= obj["radio_grados"]:
                violaciones.append(
                    f"Satélite {i + 1} invade zona de exclusión de '{obj['nombre']}' "
                    f"(distancia {dist_grados:.2f}° <= {obj['radio_grados']}°)"
                )

        # 3. Revisar separación mínima entre satélites de la misma constelación (mínimo 2°)
        for j in range(i + 1, len(configuracion)):
            dist_entre_sat = calcular_distancia_angular_grados(
                sat_lat, sat_lon, configuracion[j][0], configuracion[j][1]
            )
            if dist_entre_sat < 2.0:
                violaciones.append(
                    f"Satélites {i + 1} y {j + 1} demasiado cerca ({dist_entre_sat:.2f}° < 2.0°)"
                )

    return violaciones


def evaluar_configuracion(configuracion, regiones=None, zonas_desechos=None, objetos_ocupados=None):
    """
    Calcula el fitness total de una constelación de 8 satélites, considerando:
    - Puntos por cubrir cada una de las 6 regiones según su prioridad.
    - Bono por cercanía óptima dentro del radio de 300 km de cada región.
    - Penalización fuerte por cada violación a zonas de desechos u objetos existentes.
    """
    if regiones is None:
        regiones = obtener_regiones_iniciales()
    if zonas_desechos is None:
        zonas_desechos = obtener_zonas_desechos_iniciales()
    if objetos_ocupados is None:
        objetos_ocupados = obtener_objetos_ocupados_iniciales()

    puntaje_total = 0.0
    regiones_cubiertas = []
    regiones_no_cubiertas = []
    distancias_minimas_regiones = {}

    # 1. Evaluar cobertura de las 6 regiones
    for region in regiones:
        mejor_distancia_km = 999999.0

        for satelite in configuracion:
            dist_km = calcular_distancia_km(
                satelite[0], satelite[1], region["lat"], region["lon"]
            )
            if dist_km < mejor_distancia_km:
                mejor_distancia_km = dist_km

        distancias_minimas_regiones[region["nombre"]] = round(mejor_distancia_km, 2)

        if mejor_distancia_km <= ALCANCE_MAXIMO_SATELITE_KM:
            regiones_cubiertas.append(region["nombre"])
            puntaje_total += region["puntos"]

            # Bono extra si el satélite se posiciona dentro de los 300 km centrales de observación
            if mejor_distancia_km <= RADIO_OBSERVACION_REGION_KM:
                bono_precision = 50.0 * (1.0 - (mejor_distancia_km / RADIO_OBSERVACION_REGION_KM))
                puntaje_total += bono_precision
            else:
                proporcion = (ALCANCE_MAXIMO_SATELITE_KM - mejor_distancia_km) / (
                    ALCANCE_MAXIMO_SATELITE_KM - RADIO_OBSERVACION_REGION_KM
                )
                puntaje_total += 20.0 * proporcion
        else:
            regiones_no_cubiertas.append(region["nombre"])
            guia_cercania = max(0.0, 20.0 * (1.0 - (mejor_distancia_km / 10000.0)))
            puntaje_total += guia_cercania

    # 2. Bono por buena distribución entre satélites (evitar amontonamiento innecesario)
    for i in range(len(configuracion)):
        for j in range(i + 1, len(configuracion)):
            dist_grados = calcular_distancia_angular_grados(
                configuracion[i][0], configuracion[i][1],
                configuracion[j][0], configuracion[j][1]
            )
            if dist_grados >= 10.0:
                puntaje_total += 1.5

    # 3. Aplicar filtro de restricciones (zonas de desechos y posiciones ocupadas)
    violaciones = verificar_restricciones(configuracion, zonas_desechos, objetos_ocupados)
    es_valida = len(violaciones) == 0

    if not es_valida:
        puntaje_total -= 1000.0 * len(violaciones)

    return {
        "fitness": puntaje_total,
        "es_valida": es_valida,
        "violaciones": violaciones,
        "regiones_cubiertas": regiones_cubiertas,
        "regiones_no_cubiertas": regiones_no_cubiertas,
        "distancias_km": distancias_minimas_regiones
    }

  ]
}
